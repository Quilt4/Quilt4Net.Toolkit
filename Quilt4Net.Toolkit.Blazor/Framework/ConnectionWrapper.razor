@using Microsoft.Extensions.DependencyInjection
@using Quilt4Net.Toolkit.Framework
@* Resolved from the provider rather than @inject'ed, because a Ready host has no endpoint to probe
   and so has no reason to register a probe service. A required injection is resolved at render time
   whether or not it is used, which turned "I already hold my data" into a broken page. *@
@inject IServiceProvider ServiceProvider

@if (Ready)
{
    @* The child already has the state it renders, so there is nothing to wait for. Capabilities
       cascade as null unless a probe happened to complete earlier — a component opting in here is
       declaring it does not read them. *@
    <CascadingValue Value="@_result?.Capabilities">
        @ChildContent
    </CascadingValue>
}
else if (_result == null)
{
    <Loading Size="ProgressBarCircularSize.Small" />
}
else if (!_result.Success)
{
    @* Address is null when the failure is configuration rather than connectivity — an unconfigured
       address, or no probe service at all. Rendering the link unconditionally threw a
       NullReferenceException over the top of the message that would have explained the problem. *@
    @if (_result.Address == null)
    {
        <RadzenText>Not connected to Quilt4Net.</RadzenText>
    }
    else
    {
        <RadzenText>Not connected to <RadzenLink Text="Quilt4Net" Path="@(_result.Address.AbsoluteUri)" Target="Quilt4Net" />.</RadzenText>
    }
    <RadzenText>@_result.Message</RadzenText>
}
else
{
    <CascadingValue Value="@_result.Capabilities">
        @ChildContent
    </CascadingValue>
}

@code {
    private ConnectionResult _result;

    [Parameter]
    public Service? Service { get; set; }

    /// <summary>
    /// Set by a host component that already holds everything it renders. The connectivity probe is
    /// then neither awaited nor issued: it answers a different question than "can this render", and
    /// making it a precondition put a network round trip in front of content that was already in
    /// hand (#156).
    /// </summary>
    [Parameter]
    public bool Ready { get; set; }

    [Parameter]
    public RenderFragment ChildContent { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        if (!Service.HasValue) throw new InvalidOperationException($"No {nameof(Service)} parameter provided to {nameof(ConnectionWrapper)} component.");

        // The probe only decides between "nothing to show" and "not connected", and Ready has
        // already settled that.
        if (!Ready)
        {
            var connectionService = ServiceProvider.GetService<IConnectionService>();

            // Named rather than thrown: an unregistered probe service is a wiring mistake, and a
            // sentence saying which registration is missing is worth more than a DI exception
            // rendered as a blank page.
            _result = connectionService == null
                ? new ConnectionResult
                {
                    Success = false,
                    Message = $"No {nameof(IConnectionService)} is registered. Call AddQuilt4NetContent(), AddQuilt4NetRemoteConfiguration() or AddQuilt4NetIssues() during startup, or set Ready on this component if it already holds what it renders."
                }
                : await connectionService.CanConnectAsync(Service.Value);
        }

        await base.OnParametersSetAsync();
    }
}
